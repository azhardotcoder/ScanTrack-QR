<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local scan history database from cloud backup to protect user privacy -->
        <exclude domain="database" path="scantrack_qr_db" />
        <exclude domain="database" path="scantrack_qr_db-wal" />
        <exclude domain="database" path="scantrack_qr_db-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Transfer only user preferences; scan history database with sensitive QR payloads is excluded -->
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
