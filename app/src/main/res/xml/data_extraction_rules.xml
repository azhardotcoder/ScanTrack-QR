<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local scan history database from cloud backup to protect user privacy -->
        <exclude domain="database" path="scantrack_qr_db" />
        <exclude domain="database" path="scantrack_qr_db-wal" />
        <exclude domain="database" path="scantrack_qr_db-shm" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude scan history containing sensitive QR payloads (passwords, contacts) from device transfer -->
        <exclude domain="database" path="scantrack_qr_db" />
        <exclude domain="database" path="scantrack_qr_db-wal" />
        <exclude domain="database" path="scantrack_qr_db-shm" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
